unit URegisterCustomer;

interface

uses
  UCustomerDTO,
  UCustomerRepository;

type
  TCadastrarCliente = class
  private
    FRepository: TCustomerRepository;
  public
    constructor Create(ARepository: TCustomerRepository);

    procedure Execute(const ADTO: TCustomerDTO);
  end;

implementation

uses
  UCustomer;

constructor TCadastrarCliente.Create(ARepository: TCustomerRepository);
begin
  FRepository := ARepository;
end;

procedure TCadastrarCliente.Execute(const ADTO: TCustomerDTO);
var
  Cliente: TCustomer;
begin
  Cliente := TCustomer.Create(
    ADTO.Nome,
    ADTO.CpfCnpj,
    ADTO.Cidade
  );

  FRepository.Salvar(Cliente);
end;

end.
