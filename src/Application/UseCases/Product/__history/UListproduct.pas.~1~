unit UListproduct;

interface

uses
  System.Generics.Collections,
  UProduct,
  UProductRepository;

type
  TListarProdutos = class
  private
    FRepository: TProductRepository;
  public
    constructor Create(ARepository: TProductRepository);

    function Execute: TObjectList<TProduct>;
  end;

implementation

constructor TListarProdutos.Create(ARepository: TProductRepository);
begin
  FRepository := ARepository;
end;

function TListarProdutos.Execute: TObjectList<TProduct>;
begin
  Result := FRepository.Listar;
end;

end.
