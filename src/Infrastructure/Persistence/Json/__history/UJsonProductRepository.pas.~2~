unit UJsonProductRepository;

interface

uses
  System.Generics.Collections,
  UProduct,
  UProductRepository,
  UJsonDatabase;

type
  TJsonProductRepository = class(TInterfacedObject, TProductRepository)
  private
    FDatabase: TJsonDatabase;

    function ProximoId: Integer;
  public
    constructor Create(PDatabase: TJsonDatabase);

    procedure Salvar(PProduto: TProduct);
    function ObterPorId(PId: Integer): TProduct;
    function Listar: TObjectList<TProduct>;
  end;

implementation

uses
  System.JSON;

constructor TJsonProductRepository.Create(
  PDatabase: TJsonDatabase
);
begin
  FDatabase := PDatabase;
end;

function TJsonProductRepository.ProximoId: Integer;
var
  Lista: TObjectList<TProduct>;
  Produto: TProduct;
  MaiorId: Integer;
begin
  MaiorId := 0;
  Lista := Listar;

  try
    for Produto in Lista do
      if Produto.Id > MaiorId then
        MaiorId := Produto.Id;

    Result := MaiorId + 1;
  finally
    Lista.Free;
  end;
end;

procedure TJsonProductRepository.Salvar(
  PProduto: TProduct
);
var
  JsonArray: TJSONArray;
  JsonObject: TJSONObject;
begin
  if PProduto.Id = 0 then
    PProduto.Id := ProximoId;

  JsonArray := FDatabase.CarregarArray('produtos.json');

  try
    JsonObject := TJSONObject.Create;

    JsonObject.AddPair(
      'id',
      TJSONNumber.Create(PProduto.Id)
    );

    JsonObject.AddPair(
      'descricao',
      PProduto.Descricao
    );

    JsonObject.AddPair(
      'precoVenda',
      TJSONNumber.Create(PProduto.PrecoVenda)
    );

    JsonObject.AddPair(
      'unidadeMedida',
      PProduto.UnidadeMedida
    );

    JsonArray.AddElement(JsonObject);

    FDatabase.SalvarArray(
      'produtos.json',
      JsonArray
    );
  finally
    JsonArray.Free;
  end;
end;

function TJsonProductRepository.ObterPorId(
  PId: Integer
): TProduct;
var
  Lista: TObjectList<TProduct>;
  Produto: TProduct;
begin
  Result := nil;

  Lista := Listar;

  try
    for Produto in Lista do
    begin
      if Produto.Id = PId then
      begin
        Result := Produto;
        Lista.Extract(Produto);
        Break;
      end;
    end;
  finally
    Lista.Free;
  end;
end;

function TJsonProductRepository.Listar: TObjectList<TProduct>;
var
  JsonArray: TJSONArray;
  JsonObject: TJSONObject;
  Produto: TProduct;
  I: Integer;
begin
  Result := TObjectList<TProduct>.Create(True);

  JsonArray := FDatabase.CarregarArray('produtos.json');

  try
    for I := 0 to JsonArray.Count - 1 do
    begin
      JsonObject := JsonArray.Items[I] as TJSONObject;

      Produto := TProduct.Create(
        JsonObject.GetValue<string>('descricao'),
        JsonObject.GetValue<Currency>('precoVenda'),
        JsonObject.GetValue<string>('unidadeMedida')
      );

      Produto.Id := JsonObject.GetValue<Integer>('id');

      Result.Add(Produto);
    end;
  finally
    JsonArray.Free;
  end;
end;

end.
