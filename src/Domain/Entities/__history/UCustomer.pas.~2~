unit UCustomer;

interface

type
  TCliente = class
  private
    FId: Integer;
    FNome: string;
    FCpfCnpj: string;
    FCidade: string;

    procedure Validar;
  public
    constructor Create(
      const ANome: string;
      const ACpfCnpj: string;
      const ACidade: string
    );

    property Id: Integer read FId write FId;
    property Nome: string read FNome;
    property CpfCnpj: string read FCpfCnpj;
    property Cidade: string read FCidade;
  end;

implementation

uses
  System.SysUtils,
  DomainException;

{ TCliente }

constructor TCliente.Create(
  const ANome: string;
  const ACpfCnpj: string;
  const ACidade: string
);
begin
  FNome := Trim(ANome);
  FCpfCnpj := Trim(ACpfCnpj);
  FCidade := Trim(ACidade);

  Validar;
end;

procedure TCliente.Validar;
begin
  if FNome.IsEmpty then
    raise EDomainException.Create('O nome do cliente é obrigatório.');

  if FCpfCnpj.IsEmpty then
    raise EDomainException.Create('O CPF/CNPJ do cliente é obrigatório.');

  if FCidade.IsEmpty then
    raise EDomainException.Create('A cidade do cliente é obrigatória.');
end;

end.
