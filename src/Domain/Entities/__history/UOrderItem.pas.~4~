unit UOrderItem;

interface

uses
  UProduct;

type
  TOrderItem = class
  private
    FProduto: TProduct;
    FQuantidade: Currency;
    FValorUnitario: Currency;

    procedure Validar;
  public
    constructor Create(AProduto: TProduct; AQuantidade: Currency; AValorUnitario: Currency);

    function Total: Currency;

    property Produto: TProduct read FProduto;
    property Quantidade: Currency read FQuantidade;
    property ValorUnitario: Currency read FValorUnitario;
  end;

implementation

uses
  UDomainException;

{ TOrderItem }

constructor TOrderItem.Create(AProduto: TProduct; AQuantidade: Currency; AValorUnitario: Currency);
begin
  FProduto := AProduto;
  FQuantidade := AQuantidade;
  FValorUnitario := AValorUnitario;

  Validar;
end;

procedure TOrderItem.Validar;
begin
  if not Assigned(FProduto) then
    raise EDomainException.Create('O produto do item do pedido é obrigatório.');

  if FQuantidade <= 0 then
    raise EDomainException.Create('A quantidade deve ser maior que zero.');

  if FValorUnitario < 0 then
    raise EDomainException.Create('O valor unitário não pode ser negativo.');
end;

function TOrderItem.Total: Currency;
begin
  Result := FQuantidade * FValorUnitario;
end;

end.
