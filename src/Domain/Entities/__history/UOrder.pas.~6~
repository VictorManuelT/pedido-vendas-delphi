unit UOrder;

interface

uses
  System.Generics.Collections,
  UCustomer,
  UProduct,
  UOrderItem;

type
  TOrder = class
  private
    FId: Integer;
    FCliente: TCustomer;
    FItens: TObjectList<TOrderItem>;

    procedure ValidarCliente(ACliente: TCustomer);
  public
    constructor Create(ACliente: TCustomer);
    destructor Destroy; override;

    procedure AdicionarItem( AProduto: TProduct;AQuantidade: Currency;AValorUnitario: Currency);

    function Total: Currency;

    property Id: Integer read FId write FId;
    property Cliente: TCustomer read FCliente;
    property Itens: TObjectList<TOrderItem> read FItens;
  end;

implementation

uses
  UDomainException;

{ TOrder }

constructor TOrder.Create(ACliente: TCustomer);
begin
  ValidarCliente(ACliente);

  FCliente := ACliente;
  FItens := TObjectList<TOrderItem>.Create(True);
end;

destructor TOrder.Destroy;
begin
  FItens.Free;
  inherited;
end;

procedure TOrder.ValidarCliente(ACliente: TCustomer);
begin
  if not Assigned(ACliente) then
    raise EDomainException.Create(
      'O cliente do pedido é obrigatório.'
    );
end;

procedure TOrder.AdicionarItem(
  AProduto: TProduct;
  AQuantidade: Currency;
  AValorUnitario: Currency
);
var
  Item: TOrderItem;
begin
  Item := TOrderItem.Create(AProduto, AQuantidade, AValorUnitario);

  FItens.Add(Item);
end;

function TOrder.Total: Currency;
var
  Item: TOrder;
begin
  Result := 0;

  for Item in FItens do
    Result := Result + Item.Total;
end;

end.unit Unit1;

interface

implementation

end.
