unit UProduct;

interface

type
  TProduct = class
  private
    FId: Integer;
    FDescricao: string;
    FPrecoVenda: Currency;
    FUnidadeMedida: string;

    procedure Validar;
  public
    constructor Create(
      const ADescricao: string;
      APrecoVenda: Currency;
      const AUnidadeMedida: string
    );

    property Id: Integer read FId write FId;
    property Descricao: string read FDescricao;
    property PrecoVenda: Currency read FPrecoVenda;
    property UnidadeMedida: string read FUnidadeMedida;
  end;

implementation

uses
  System.SysUtils,
  UDomainException;

{ TProduct }

constructor TProduct.Create(const ADescricao: string; APrecoVenda: Currency; const AUnidadeMedida: string);
begin
  FDescricao := Trim(ADescricao);
  FPrecoVenda := APrecoVenda;
  FUnidadeMedida := Trim(AUnidadeMedida);

  Validar;
end;

procedure TProduct.Validar;
begin
  if FDescricao.IsEmpty then
    raise EDomainException.Create('A descrição do produto é obrigatória.');

  if FPrecoVenda < 0 then
    raise EDomainException.Create('O preço de venda não pode ser negativo.');

  if FUnidadeMedida.IsEmpty then
    raise EDomainException.Create('A unidade de medida é obrigatória.');
end;

end.
