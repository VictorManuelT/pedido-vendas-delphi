unit UPrincipal;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Variants,
  System.Classes,
  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls;

type
  TFrmPrincipal = class(TForm)
    lblTitulo: TLabel;
    btnCustomers: TButton;
    btnOrders: TButton;
    procedure btnCustomersClick(Sender: TObject);
    procedure btnProductsClick(Sender: TObject);
    procedure btnOrdersClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmPrincipal: TFrmPrincipal;

implementation

{$R *.dfm}

uses
  UCustomer,
  UProduct,
  UOrder;

procedure TFrmPrincipal.btnCustomersClick(Sender: TObject);
begin
  TFrmCustomers.ShowModal;
end;

procedure TFrmPrincipal.btnProductsClick(Sender: TObject);
begin
  TFrmProducts.ShowModal;
end;

procedure TFrmPrincipal.btnOrdersClick(Sender: TObject);
begin
  FrmOrder.ShowModal;
end;

end.
