unit UFrmCustomers;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Classes,
  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls,
  Vcl.Grids,
  UJsonDatabase,
  UJsonCustomerRepository,
  URegisterCustomer,
  UCustomerDTO,
  UListCustomer,
  UCustomer,
  System.Generics.Collections;

type
  TFrmCustomers = class(TForm)
    lblTitle: TLabel;
    lblName: TLabel;
    lblCpfCnpj: TLabel;
    lblCity: TLabel;
    edtName: TEdit;
    edtCpfCnpj: TEdit;
    edtCity: TEdit;
    btnSave: TButton;
    btnClose: TButton;
    grdCustomers: TStringGrid;
    procedure FormCreate(Sender: TObject);
    procedure btnSaveClick(Sender: TObject);
    procedure btnClearClick(Sender: TObject);
    procedure btnCloseClick(Sender: TObject);
  private
    procedure ClearFields;
    procedure ConfigureGrid;
  public
    procedure LoadCustomers;
  end;

var
  FrmCustomers: TFrmCustomers;

implementation

{$R *.dfm}

procedure TFrmCustomers.FormCreate(Sender: TObject);
begin
  ConfigureGrid;
end;

procedure TFrmCustomers.ConfigureGrid;
begin
  grdCustomers.ColCount := 4;
  grdCustomers.RowCount := 1;
  grdCustomers.FixedRows := 1;

  grdCustomers.Cells[0, 0] := 'ID';
  grdCustomers.Cells[1, 0] := 'Nome';
  grdCustomers.Cells[2, 0] := 'CPF/CNPJ';
  grdCustomers.Cells[3, 0] := 'Cidade';

  grdCustomers.ColWidths[0] := 60;
  grdCustomers.ColWidths[1] := 250;
  grdCustomers.ColWidths[2] := 150;
  grdCustomers.ColWidths[3] := 180;
end;

procedure TFrmCustomers.LoadCustomers;
var
  Database: TJsonDatabase;
  Repository: TJsonCustomerRepository;
  ListarClientes: TListarClientes;
  Clientes: TObjectList<TCustomer>;
  Cliente: TCustomer;
  I: Integer;
begin
  Database := TJsonDatabase.Create;
  try
    Repository := TJsonCustomerRepository.Create(Database);
    try
      ListarClientes := TListarClientes.Create(Repository);
      try
        Clientes := ListarClientes.Execute;

        try
          grdCustomers.RowCount := Clientes.Count + 1;

          for I := 0 to Clientes.Count - 1 do
          begin
            Cliente := Clientes[I];

            grdCustomers.Cells[0, I + 1] := IntToStr(Cliente.Id);
            grdCustomers.Cells[1, I + 1] := Cliente.Nome;
            grdCustomers.Cells[2, I + 1] := Cliente.CpfCnpj;
            grdCustomers.Cells[3, I + 1] := Cliente.Cidade;
          end;
        finally
          Clientes.Free;
        end;
      finally
        ListarClientes.Free;
      end;
    finally
      Repository := nil;
    end;
  finally
    Database.Free;
  end;
end;

procedure TFrmCustomers.ClearFields;
begin
  edtName.Clear;
  edtCpfCnpj.Clear;
  edtCity.Clear;

  edtName.SetFocus;
end;

procedure TFrmCustomers.btnSaveClick(Sender: TObject);
var
  Database: TJsonDatabase;
  Repository: TJsonCustomerRepository;
  CadastrarCliente: TCadastrarCliente;
  DTO: TCustomerDTO;
begin
  if Trim(edtName.Text) = '' then
  begin
    ShowMessage('Informe o nome do cliente.');
    edtName.SetFocus;
    Exit;
  end;

  if Trim(edtCpfCnpj.Text) = '' then
  begin
    ShowMessage('Informe o CPF/CNPJ do cliente.');
    edtCpfCnpj.SetFocus;
    Exit;
  end;

  if Trim(edtCity.Text) = '' then
  begin
    ShowMessage('Informe a cidade do cliente.');
    edtCity.SetFocus;
    Exit;
  end;

  DTO.Nome := Trim(edtName.Text);
  DTO.CpfCnpj := Trim(edtCpfCnpj.Text);
  DTO.Cidade := Trim(edtCity.Text);

  Database := TJsonDatabase.Create;
  try
    Repository := TJsonCustomerRepository.Create(Database);
    try
      CadastrarCliente := TCadastrarCliente.Create(Repository);
      try
        CadastrarCliente.Execute(DTO);
      finally
        CadastrarCliente.Free;
      end;
    finally
      Repository := nil;
    end;
  finally
    Database.Free;
  end;

  ShowMessage('Cliente cadastrado com sucesso.');

  ClearFields;
  LoadCustomers;
end;

procedure TFrmCustomers.btnClearClick(Sender: TObject);
begin
  ClearFields;
end;

procedure TFrmCustomers.btnCloseClick(Sender: TObject);
begin
  Close;
end;

end.
