unit UFrmProducts;

interface

uses
  Winapi.Windows,
  Winapi.Messages,
  System.SysUtils,
  System.Variants,
  System.Classes,
  Vcl.Graphics,
  Vcl.Controls,
  Vcl.Forms,
  Vcl.Dialogs,
  Vcl.StdCtrls,
  Vcl.Grids;

type
  TFrmProducts = class(TForm)
    lblTitle: TLabel;
    lblDescription: TLabel;
    lblSalePrice: TLabel;
    lblUnit: TLabel;
    edtDescription: TEdit;
    edtSalePrice: TEdit;
    edtUnit: TEdit;
    btnSave: TButton;
    btnClear: TButton;
    btnClose: TButton;
    grdProducts: TStringGrid;
    procedure btnSaveClick(Sender: TObject);
    procedure btnClearClick(Sender: TObject);
    procedure btnCloseClick(Sender: TObject);
  private
    procedure ClearFields;
    procedure ConfigureGrid;
  public
    procedure LoadProducts;
  end;

var
  FrmProducts: TFrmProducts;

implementation

{$R *.dfm}

procedure TFrmProducts.ConfigureGrid;
begin
  grdProducts.ColCount := 4;
  grdProducts.RowCount := 1;
  grdProducts.FixedRows := 1;

  grdProducts.Cells[0, 0] := 'ID';
  grdProducts.Cells[1, 0] := 'Description';
  grdProducts.Cells[2, 0] := 'Sale Price';
  grdProducts.Cells[3, 0] := 'Unit';

  grdProducts.ColWidths[0] := 60;
  grdProducts.ColWidths[1] := 300;
  grdProducts.ColWidths[2] := 130;
  grdProducts.ColWidths[3] := 100;
end;

procedure TFrmProducts.LoadProducts;
begin
  { Será conectado ao TListarProdutos posteriormente. }
end;

procedure TFrmProducts.ClearFields;
begin
  edtDescription.Clear;
  edtSalePrice.Clear;
  edtUnit.Clear;
  edtDescription.SetFocus;
end;

procedure TFrmProducts.btnSaveClick(Sender: TObject);
begin
  { Será conectado ao TCadastrarProduto posteriormente. }
end;

procedure TFrmProducts.btnClearClick(Sender: TObject);
begin
  ClearFields;
end;

procedure TFrmProducts.btnCloseClick(Sender: TObject);
begin
  Close;
end;

end.
